# Copy to .env.local and fill in your own values.

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon — https://console.neon.tech
# DATABASE_URL: the DIRECT connection. Used by drizzle-kit for migrations.
# DATABASE_URL_POOLED: the pooler connection (host contains "-pooler"). Used by the app.
# Neon URLs end in `?sslmode=require`. That is pinned to `verify-full` at connect
# time — which is what it already means — so `pg` stops warning about it.
DATABASE_URL=
DATABASE_URL_POOLED=

# Salt for hashing respondent IPs. Any long random string works.
RESPONSE_HASH_SALT=

# Optional. Where errors are forwarded once they are logged. Leave it empty and
# failures are still written as one JSON line on stderr (which the host collects);
# set it to a collector's endpoint and the same payload is POSTed there too.
# The rate limit and the honeypot need no configuration.
ERROR_REPORT_URL=

# Optional. This deployment's public address, used to build the absolute URLs in
# social-card metadata and in /robots.txt and /sitemap.xml. A bare hostname or a
# full URL both work: `forms.example.com` and `https://forms.example.com` are the
# same. Needed for a self-hosted box — a crawler has no request context to infer
# the host from, and guessing one from the request would be a way to point a link
# preview somewhere else. On Vercel it falls back to the project's own hostname,
# so it can be left unset there.
NEXT_PUBLIC_SITE_URL=

# Agent access — https://agentonboard.xyz
#
# Set AON_AUDIENCE to this deployment's bare hostname (no scheme, no trailing
# slash, no port) and agents can sign in with an AgentOnboard token, create an
# account, and use the whole product. It must match the hostname you serve on
# **exactly**, and it must match the `## Audience` line of the /auth.md this app
# serves — which is rendered from this value, so the two cannot drift.
#
# Leave it empty and agent access is off: the agent routes answer 500
# CONFIG_ERROR and /auth.md 404s. Nothing else changes.
#
# Do not derive this from the request. An audience the caller controls is not a
# check — obeying it is how a token minted for someone else's service is accepted
# here. See docs/design.md.
AON_AUDIENCE=

# Optional. Only for a staging or self-hosted AgentOnboard-compatible issuer.
# Unset means the production issuer and its published key set.
# AON_ISSUER=

# End-to-end tests (`pnpm test:e2e`) — never needed to run the app. The suite
# signs in as a real Clerk user and writes real rows, then deletes them. The
# defaults below work as they are against a Clerk *development* instance: the
# `+clerk_test` subaddress is a reserved test address, so no email is sent, and
# the setup project creates the user if it does not exist.
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
# E2E_CLERK_USER_PASSWORD=formeasy-e2e-password
